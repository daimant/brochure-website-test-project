PORT=3001

# ─── SMTP ────────────────────────────────────────────────────────────────────
# Gmail: включите "App Passwords" (2FA обязательна)
# Yandex: используйте пароль приложения из настроек безопасности
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password

# Email владельца сайта (куда приходят заявки)
OWNER_EMAIL=your@gmail.com

# ─── OpenAI ──────────────────────────────────────────────────────────────────
# Получить ключ: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Модель (gpt-4o-mini — быстрая и дешёвая, gpt-4o — умнее)
OPENAI_MODEL=gpt-4o-mini
